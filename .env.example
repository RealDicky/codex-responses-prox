# Model routing JSON - each model maps to its upstream provider
# Codex sends the model name, proxy routes to the right gateway
MODEL_ROUTING={"astron-code-latest":{"base_url":"https://maas-coding-api.cn-huabei-1.xf-yun.com/v2","api_key":"your-xfyun-key","upstream_model":"astron-code-latest"},"deepseek-v4-pro":{"base_url":"https://api.deepseek.com/v1","api_key":"your-deepseek-key","upstream_model":"deepseek-v4-pro"}}

# Proxy port
PORT=31415
